# .env  —  Docker Compose infrastructure variables
#
# Copy this file to .env and fill in your values.
# These are interpolated by `docker compose --env-file .env` (see Makefile).
# They control image names, ports, paths, and host UID/GID mapping.
#
# NOTE: This is NOT the agent's runtime env file.
#       API keys and secrets go in <HERMES_DATA>/.env (e.g. ../hermes-work/.env),
#       which is mounted into the containers at runtime via `env_file:` in docker-compose.yml.

HERMES_IMAGE=hermes-work:0.1

HERMES_DATA=../hermes-work
HERMES_PORT=8642
API_SERVER_KEY=test-integration-key
HERMES_DASHBOARD_PORT=9119

HERMES_UID=501       # ← change to your UID (run `id -u`)
HERMES_GID=20        # ← change to your GID (run `id -g`)

# REPO_ROOT — set to wherever your Code directory lives, e.g. /Users/you/Code
REPO_ROOT=..
