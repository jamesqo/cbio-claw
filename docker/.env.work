HERMES_IMAGE=hermes-work:0.1

# Docker compose shared variables
HERMES_DATA=../hermes-work
HERMES_PORT=8642
API_SERVER_KEY=test-integration-key
HERMES_DASHBOARD_PORT=9119

HERMES_UID=501       # ← change to your UID (run `id -u`)
HERMES_GID=20        # ← change to your GID (run `id -g`)

# REPO_ROOT — set to wherever your Code directory lives, e.g. /Users/you/Code
REPO_ROOT=../..
