#!/bin/bash
# resource-usage — report CPU, memory, and disk utilization
# Designed to be run by Hermes for the resource-monitoring channel.

echo "=== CPU ==="
# Overall CPU idle % from a 1-second sample; derive usage %
CPU_IDLE=$(top -bn1 | grep "^%Cpu" | awk '{print $8}')
CPU_USED=$(awk "BEGIN {printf \"%.1f\", 100 - ${CPU_IDLE}}")
echo "Usage:  ${CPU_USED}%"
echo ""
echo "Top processes by CPU:"
ps aux --sort=-%cpu | awk 'NR==1 || NR<=6 {printf "  %-10s %-6s %-6s %s\n", $1, $2, $3, $11}' | head -6

echo ""
echo "=== MEMORY ==="
free -h | awk '
  /^Mem:/ {
    printf "Total:     %s\n", $2
    printf "Used:      %s\n", $3
    printf "Available: %s\n", $7
  }
  /^Swap:/ {
    printf "Swap used: %s / %s\n", $3, $2
  }
'
echo ""
echo "Top processes by memory:"
ps aux --sort=-%mem | awk 'NR==1 || NR<=6 {printf "  %-10s %-6s %-6s %s\n", $1, $2, $4, $11}' | head -6

echo ""
echo "=== DISK ==="
df -h --output=target,size,used,avail,pcent | grep -v "^tmpfs\|^udev\|^/dev/loop" | \
  awk 'NR==1 || $5+0 > 0 {print "  " $0}'
